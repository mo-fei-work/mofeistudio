---
// 全站顶部导航行：只管行内排版，不自己管底色、分隔线和吸顶。
// 通栏底色、1px 分隔线、sticky 都在 Base.astro 的外层容器上。
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: "zh" | "en";
  altHref: string;
}

const { lang, altHref } = Astro.props;

// 语言名在两种语言下写法一样；导航的无障碍标签按当前语言取。
const labels =
  lang === "zh"
    ? { zh: "中文", en: "English", navigation: "顶部导航" }
    : { zh: "中文", en: "English", navigation: "Top navigation" };

const linkClass =
  "text-neutral-600 underline-offset-4 hover:underline dark:text-neutral-400";

// 字标是首页入口，不是链接文字：悬停只加深一档，不加下划线。
// 字号、字距、加粗和页尾那个 MOFEI STUDIO 字标同一套（20px / 0.05em / 700），
// 只降一档成次灰，并且必须保持单行，所以留着 whitespace-nowrap 与 shrink-0。
// 窄屏降一档到 18px：英文页右侧的 Light/Dark 比中文的亮/暗宽 27px，
// 20px 字标在 390px 下会把右边距挤到 8px；md（768px）以上仍是 20px。
const brandClass =
  "shrink-0 whitespace-nowrap text-lg font-bold tracking-wider text-neutral-600 hover:text-neutral-900 md:text-xl dark:text-neutral-400 dark:hover:text-neutral-100";
const homeHref = lang === "zh" ? "/" : "/en/";
---

<header class="py-2.5">
  <nav
    class="flex items-center justify-between gap-4"
    aria-label={labels.navigation}
  >
    <a class={brandClass} href={homeHref}>
      MOFEI STUDIO
    </a>

    <div class="flex shrink-0 items-center gap-4 whitespace-nowrap">
      <div class="flex items-center whitespace-nowrap text-xs">
        {lang === "zh" ? (
          <span class="text-neutral-900 dark:text-neutral-100">
            {labels.zh}
          </span>
        ) : (
          <a class={linkClass} href={altHref}>
            {labels.zh}
          </a>
        )}
        <span
          class="px-1.5 text-neutral-300 dark:text-neutral-700"
          aria-hidden="true"
        >
          /
        </span>
        {lang === "en" ? (
          <span class="text-neutral-900 dark:text-neutral-100">
            {labels.en}
          </span>
        ) : (
          <a class={linkClass} href={altHref}>
            {labels.en}
          </a>
        )}
      </div>

      <ThemeToggle lang={lang} />
    </div>
  </nav>
</header>
