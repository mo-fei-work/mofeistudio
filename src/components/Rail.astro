---
// 右栏：桌面 192px 宽、1px 左边线、24px 左内边距，窄屏整条不显示。
// 组顺序固定：目录 → 相关 → 关注我 → 联系我 → 订阅，链接一律 14px。
// 目录只在文章有 h2 时出现（大肥鱼篇 0 个 h2，就没有这一组）。
import type { MarkdownHeading } from "astro";

type RelatedLink = { href: string; title: string };

interface Props {
  lang: "zh" | "en";
  related?: RelatedLink[];
  headings?: MarkdownHeading[];
}

const { lang, related = [], headings = [] } = Astro.props;

// 三篇文章都只有 h2；收窄到 depth 2 是为了以后加 h3 时子标题不混进目录。
const contents = headings.filter((heading) => heading.depth === 2);

const labels =
  lang === "zh"
    ? {
        contents: "目录",
        related: "相关",
        follow: "关注我",
        contact: "联系我",
        subscribe: "订阅",
        bilibili: "B站",
        wechat: {
          label: "公众号",
          caption: "微信公众号",
          alt: "微信公众号二维码",
        },
      }
    : {
        contents: "Contents",
        related: "Related",
        follow: "Follow",
        contact: "Contact",
        subscribe: "Subscribe",
        bilibili: "Bilibili",
        wechat: {
          label: "WeChat",
          caption: "WeChat Official Account",
          alt: "WeChat Official Account QR code",
        },
      };

const follow = {
  superlinear: "https://www.superlinear.academy/",
  bilibili: "https://space.bilibili.com/",
  github: "https://github.com/mo-fei-work",
  emailLabel: "mo-fei-work@foxmail.com",
  email: "mailto:mo-fei-work@foxmail.com",
};

const labelClass =
  "text-xs font-medium tracking-widest text-neutral-400 dark:text-neutral-500";
const linkClass =
  "text-neutral-600 underline-offset-4 hover:underline dark:text-neutral-400";
const wechatButtonClass = `${linkClass} cursor-pointer appearance-none border-0 bg-transparent p-0 text-left`;
---

<aside class="rail rail-scroll hidden shrink-0 md:sticky md:block md:w-48 md:self-start md:border-l md:pl-6 dark:border-neutral-800">
  <nav class="flex flex-col gap-8 text-sm">
    {contents.length > 0 && (
      <div>
        <p class={`${labelClass} mb-2`}>{labels.contents}</p>
        <ol class="space-y-2">
          {contents.map((heading) => (
            <li>
              <a class={linkClass} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    )}

    {related.length > 0 && (
      <div>
        <p class={`${labelClass} mb-2`}>{labels.related}</p>
        <ul class="space-y-2">
          {related.map((item) => (
            <li>
              <a class={linkClass} href={item.href}>
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div>
      <p class={`${labelClass} mb-2`}>{labels.follow}</p>
      <ul class="space-y-2">
        <li>
          <a
            class={linkClass}
            href={follow.superlinear}
            target="_blank"
            rel="noreferrer"
          >
            superlinear
          </a>
        </li>
        <li>
          <a
            class={linkClass}
            href={follow.bilibili}
            target="_blank"
            rel="noreferrer"
          >
            {labels.bilibili}
          </a>
        </li>
        <li>
          <span class="relative inline-flex" data-wechat>
            <button
              type="button"
              aria-expanded="false"
              aria-controls="rail-wechat-qr"
              class={wechatButtonClass}
              data-wechat-trigger
            >
              {labels.wechat.label}
            </button>
            <!-- 面板统一朝上（data-wechat-dir="up"），位置由 Base.astro 的脚本按
                 触发器在视口里的矩形现算。右栏是 overflow-y: auto 的滚动容器，
                 absolute 面板一定被它的裁剪盒切掉，所以这里用 fixed：
                 固定定位的定位基准是视口，不受任何祖先的 overflow 影响。 -->
            <span
              id="rail-wechat-qr"
              hidden
              class="fixed z-50 block w-max pt-2"
              data-wechat-dir="up"
              data-wechat-panel
            >
              <span class="block rounded border border-neutral-200 bg-white p-2 shadow-lg">
                <img
                  src="/wechat-qr.jpg"
                  alt={labels.wechat.alt}
                  width="430"
                  height="430"
                  class="h-32 w-32"
                />
                <span class="mt-1 block text-center text-xs text-neutral-500">
                  {labels.wechat.caption}
                </span>
              </span>
            </span>
          </span>
        </li>
        <li>
          <a
            class={linkClass}
            href={follow.github}
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class={`${labelClass} mb-2`}>{labels.contact}</p>
      <ul class="space-y-2">
        <li>
          <a class={`${linkClass} whitespace-nowrap`} href={follow.email}>
            {follow.emailLabel}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class={`${labelClass} mb-2`}>{labels.subscribe}</p>
      <ul class="space-y-2">
        <li>
          <a class={linkClass} href="/rss.xml">
            RSS
          </a>
        </li>
      </ul>
    </div>
  </nav>
</aside>

<style>
  /* 冻结顶栏占 0–47px：右栏要吸在「栏高 + 32px」处，否则第一组标签会被栏盖住。
     内容超出一屏时右栏内部滚，五组全保留。
     z-index 是给二维码面板用的：position: sticky 会造一个层叠上下文，
     面板的 z-50 会被关在里面，压不过顶栏的 z-40；右栏本身吸在 79px 以下，
     抬高层级不会盖到顶栏，只让面板能越出去。 */
  @media (min-width: 48rem) {
    .rail {
      top: calc(var(--topbar-h) + 2rem);
      max-height: calc(100vh - var(--topbar-h) - 2rem);
      overflow-y: auto;
      z-index: 50;
    }
  }
</style>
