---
// 右栏：桌面 160px 宽、1px 左边线、24px 左内边距，窄屏整条不显示。
// 组顺序固定：目录 → 更多 → 相关 → 关注我。
// 目录只在文章有 h2 时出现（大肥鱼篇 0 个 h2，就没有这一组）。
import type { MarkdownHeading } from "astro";

type RelatedLink = { href: string; title: string };

interface Props {
  lang: "zh" | "en";
  related?: RelatedLink[];
  headings?: MarkdownHeading[];
}

const { lang, related = [], headings = [] } = Astro.props;

// 三篇文章都只有 h2；收窄到 depth 2 是为了以后加 h3 时子标题不混进目录。
const contents = headings.filter((heading) => heading.depth === 2);

const labels =
  lang === "zh"
    ? {
        contents: "目录",
        more: "更多",
        related: "相关",
        follow: "关注我",
        rss: "订阅 RSS",
        bilibili: "B站",
        wechat: {
          label: "公众号",
          caption: "微信公众号",
          alt: "微信公众号二维码",
        },
      }
    : {
        contents: "Contents",
        more: "More",
        related: "Related",
        follow: "Follow",
        rss: "RSS",
        bilibili: "Bilibili",
        wechat: {
          label: "WeChat",
          caption: "WeChat Official Account",
          alt: "WeChat Official Account QR code",
        },
      };

// 内容与页尾关注行一致：superlinear / B站 / 公众号 / GitHub / 邮箱。
const follow = {
  superlinear: "https://www.superlinear.academy/",
  bilibili: "https://space.bilibili.com/",
  github: "https://github.com/mo-fei-work",
  emailLabel: "mo-fei-work@foxmail.com",
  email: "mailto:mo-fei-work@foxmail.com",
};

const labelClass =
  "text-xs font-medium tracking-widest text-neutral-400 dark:text-neutral-500";
const linkClass =
  "text-neutral-600 underline-offset-4 hover:underline dark:text-neutral-400";
const wechatButtonClass = `${linkClass} cursor-pointer appearance-none border-0 bg-transparent p-0 text-left text-xs`;
---

<aside class="rail rail-scroll hidden shrink-0 md:sticky md:block md:w-40 md:self-start md:border-l md:pl-6 dark:border-neutral-800">
  <nav class="flex flex-col gap-8">
    {contents.length > 0 && (
      <div>
        <p class={`${labelClass} mb-2`}>{labels.contents}</p>
        <ol class="space-y-2 text-xs">
          {contents.map((heading) => (
            <li>
              <a class={linkClass} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    )}

    <div>
      <p class={`${labelClass} mb-2`}>{labels.more}</p>
      <ul class="space-y-2 text-sm">
        <li>
          <a class={linkClass} href="/rss.xml">
            {labels.rss}
          </a>
        </li>
      </ul>
    </div>

    {related.length > 0 && (
      <div>
        <p class={`${labelClass} mb-2`}>{labels.related}</p>
        <ul class="space-y-2 text-sm">
          {related.map((item) => (
            <li>
              <a class={linkClass} href={item.href}>
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div>
      <p class={`${labelClass} mb-2`}>{labels.follow}</p>
      <ul class="space-y-2 text-xs">
        <li>
          <a
            class={linkClass}
            href={follow.superlinear}
            target="_blank"
            rel="noreferrer"
          >
            superlinear
          </a>
        </li>
        <li>
          <a
            class={linkClass}
            href={follow.bilibili}
            target="_blank"
            rel="noreferrer"
          >
            {labels.bilibili}
          </a>
        </li>
        <li>
          <span class="relative inline-flex" data-wechat>
            <button
              type="button"
              aria-expanded="false"
              aria-controls="rail-wechat-qr"
              class={wechatButtonClass}
              data-wechat-trigger
            >
              {labels.wechat.label}
            </button>
            <!-- 面板朝上开（bottom-full）。右栏是滚动容器：overflow-y: auto 会让
                 overflow-x 也变成 auto，朝下开的面板会被右栏底部裁掉 110px，整个打不开。
                 页尾的触发器在页面最底部，那边也是 bottom-full，但原因不同：下方没有空间。
                 -left-6 抵掉右栏的 24px 左内边距，否则面板比 135px 净宽宽，
                 会被右栏的 overflow 裁掉；右栏宽 160px，面板最宽 154px，正好放得下。 -->
            <span
              id="rail-wechat-qr"
              hidden
              class="absolute bottom-full -left-6 z-10 block w-max pt-2"
              data-wechat-panel
            >
              <span class="block rounded border border-neutral-200 bg-white p-2 shadow-lg">
                <img
                  src="/wechat-qr.jpg"
                  alt={labels.wechat.alt}
                  width="430"
                  height="430"
                  class="h-32 w-32"
                />
                <span class="mt-1 block text-center text-xs text-neutral-500">
                  {labels.wechat.caption}
                </span>
              </span>
            </span>
          </span>
        </li>
        <li>
          <a
            class={linkClass}
            href={follow.github}
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        </li>
        <li>
          <a class={linkClass} href={follow.email}>
            {follow.emailLabel}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</aside>

<style>
  /* 冻结顶栏占 0–47px：右栏要吸在「栏高 + 32px」处，否则第一组标签会被栏盖住。
     内容超出一屏时右栏内部滚，四组全保留。 */
  @media (min-width: 48rem) {
    .rail {
      top: calc(var(--topbar-h) + 2rem);
      max-height: calc(100vh - var(--topbar-h) - 2rem);
      overflow-y: auto;
    }
  }
</style>
