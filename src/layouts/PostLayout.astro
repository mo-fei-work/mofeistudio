---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Base from "./Base.astro";

type PostEntry = CollectionEntry<"postsZh"> | CollectionEntry<"postsEn">;

interface Props {
  entry: PostEntry;
  lang: "zh" | "en";
}

const { entry, lang } = Astro.props;
const prefix = lang === "zh" ? "" : "/en";
const homeHref = lang === "zh" ? "/" : "/en/";
const postsHref = lang === "zh" ? "/#posts" : "/en/#posts";
const altHref = lang === "zh" ? `/en/posts/${entry.id}` : `/posts/${entry.id}`;

const allZh = await getCollection("postsZh");
const allEn = await getCollection("postsEn");
const siblings: PostEntry[] = lang === "zh" ? allZh : allEn;
const ordered = [...siblings].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const index = ordered.findIndex((post) => post.id === entry.id);
const previous = index > 0 ? ordered[index - 1] : undefined;
const next =
  index >= 0 && index < ordered.length - 1 ? ordered[index + 1] : undefined;

const relatedLinks: { href: string; title: string }[] = [];
for (const slug of entry.data.related) {
  const match = siblings.find((post) => post.id === slug);
  if (match) {
    relatedLinks.push({
      href: `${prefix}/posts/${match.id}`,
      title: match.data.title,
    });
  }
}

const typeLabels =
  lang === "zh"
    ? {
        event: "事件 → 教训",
        judgment: "判断 → 论证",
        solution: "问题 → 方案",
      }
    : {
        event: "Event → Lesson",
        judgment: "Judgment → Argument",
        solution: "Problem → Solution",
      };

const labels =
  lang === "zh"
    ? {
        breadcrumb: "面包屑",
        home: "首页",
        posts: "我的文章",
        previous: "上一篇",
        next: "下一篇",
        navigation: "文章导航",
        signature: "得无",
        license: "本文采用 CC BY 4.0 许可。",
        citation: "引用请注明出处，以站内版本为准。",
      }
    : {
        breadcrumb: "Breadcrumb",
        home: "Home",
        posts: "My posts",
        previous: "Previous",
        next: "Next",
        navigation: "Post navigation",
        signature: "得无",
        license: "This post is licensed under CC BY 4.0.",
        citation:
          "Please cite the source; the version on this site is authoritative.",
      };

function stripMarkdown(source: string): string {
  return source
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/^[#>*+-]+\s*/gm, " ");
}

function countWords(source: string): number {
  const text = stripMarkdown(source);
  if (lang === "zh") {
    const cjk = (text.match(/[\u3400-\u4dbf\u4e00-\u9fff]/g) ?? []).length;
    const latin = (
      text
        .replace(/[\u3400-\u4dbf\u4e00-\u9fff]/g, " ")
        .match(/[A-Za-z0-9]+(?:['’.-][A-Za-z0-9]+)*/g) ?? []
    ).length;
    return cjk + latin;
  }
  return (text.match(/[A-Za-z0-9]+(?:['’.-][A-Za-z0-9]+)*/g) ?? []).length;
}

const wordCount = countWords(entry.body ?? "");
const wordCountLabel = wordCount.toLocaleString(
  lang === "zh" ? "zh-CN" : "en-US",
);
const minutes = Math.max(1, Math.ceil(wordCount / (lang === "zh" ? 400 : 220)));
const readTimeLabel =
  lang === "zh" ? `约 ${minutes} 分钟` : `${minutes} min read`;

const date = new Intl.DateTimeFormat(lang === "zh" ? "sv-SE" : "en-US", {
  year: "numeric",
  month: lang === "zh" ? "2-digit" : "short",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
}).format(entry.data.date);

const title = `${entry.data.title} · ${lang === "zh" ? "莫非" : "MO Fei"}`;
---

<Base
  lang={lang}
  title={title}
  description={entry.data.summary}
  altHref={altHref}
  related={relatedLinks}
>
  <article class="max-w-xl">
    <nav
      class="flex min-w-0 items-center gap-x-2 text-xs"
      aria-label={labels.breadcrumb}
    >
      <a
        class="shrink-0 text-neutral-500 underline-offset-4 hover:underline dark:text-neutral-400"
        href={homeHref}
      >
        {labels.home}
      </a>
      <span
        class="shrink-0 text-neutral-300 dark:text-neutral-700"
        aria-hidden="true"
      >
        /
      </span>
      <a
        class="shrink-0 text-neutral-500 underline-offset-4 hover:underline dark:text-neutral-400"
        href={postsHref}
      >
        {labels.posts}
      </a>
      <span
        class="shrink-0 text-neutral-300 dark:text-neutral-700"
        aria-hidden="true"
      >
        /
      </span>
      <span
        class="min-w-0 truncate text-neutral-500 dark:text-neutral-400"
        aria-current="page"
      >
        {entry.data.title}
      </span>
    </nav>

    <h1 class="mt-6 text-3xl font-bold tracking-tight">{entry.data.title}</h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-neutral-500 dark:text-neutral-400">
      <span>
        {date} · {wordCountLabel} {lang === "zh" ? "字" : "words"}
      </span>
      <span class="rounded-full border border-neutral-300 px-2 py-0.5 dark:border-neutral-700">
        {typeLabels[entry.data.type]}
      </span>
      <span class="ml-auto">{readTimeLabel}</span>
    </div>

    <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
      {labels.signature}
    </p>

    <div class="prose mt-8">
      <slot />
    </div>

    <div class="mt-10 border-t border-neutral-200 pt-4 text-xs text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
      <p>{labels.license}</p>
      <p class="mt-1">{labels.citation}</p>
    </div>

    {(previous || next) && (
      <nav
        class="mt-10 flex justify-between gap-4 border-t border-neutral-200 pt-6 dark:border-neutral-800"
        aria-label={labels.navigation}
      >
        {previous && (
          <div class="min-w-0">
            <p class="text-xs text-neutral-400 dark:text-neutral-500">
              {labels.previous}
            </p>
            <a
              class="mt-1 block text-sm underline-offset-4 hover:underline"
              href={`${prefix}/posts/${previous.id}`}
            >
              {previous.data.title}
            </a>
          </div>
        )}
        {next && (
          <div class={`min-w-0 text-right ${previous ? "" : "ml-auto"}`}>
            <p class="text-xs text-neutral-400 dark:text-neutral-500">
              {labels.next}
            </p>
            <a
              class="mt-1 block text-sm underline-offset-4 hover:underline"
              href={`${prefix}/posts/${next.id}`}
            >
              {next.data.title}
            </a>
          </div>
        )}
      </nav>
    )}
  </article>
</Base>
