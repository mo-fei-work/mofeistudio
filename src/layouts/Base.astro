---
import "../styles/global.css";
import "@fontsource/jetbrains-mono/400.css";
import type { MarkdownHeading } from "astro";
import SiteHead from "../components/SiteHead.astro";
import TopNav from "../components/TopNav.astro";
import Rail from "../components/Rail.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  lang: "zh" | "en";
  title: string;
  description?: string;
  altHref: string;
  related?: { href: string; title: string }[];
  headings?: MarkdownHeading[];
  noIndex?: boolean;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  altHref,
  related = [],
  headings = [],
  noIndex,
  ogType,
  jsonLd,
} = Astro.props;
const htmlLang = lang === "zh" ? "zh-CN" : "en";

// 共享二维码面板的文案：Banner / 右栏 / 页尾三处共用同一个面板，所以文案也由这一处给。
const wechat =
  lang === "zh"
    ? { caption: "微信公众号", alt: "微信公众号二维码" }
    : {
        caption: "WeChat Official Account",
        alt: "WeChat Official Account QR code",
      };
---

<!doctype html>
<html lang={htmlLang}>
  <SiteHead
    title={title}
    description={description}
    lang={lang}
    noIndex={noIndex}
    ogType={ogType}
    jsonLd={jsonLd}
  />
  <body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-900 dark:text-neutral-200">
    <!-- 冻结顶栏：外层通栏给底色和分隔线，内层再限 896px 版心。
         底色不能只给 896px 的容器，否则视口更宽时栏两侧会漏出滚动正文。 -->
    <div class="sticky top-0 z-40 border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
      <div class="mx-auto max-w-4xl px-6">
        <TopNav lang={lang} altHref={altHref} />
      </div>
    </div>

    <!-- 顶栏移出容器后，最小高度要扣掉栏高，否则短页也会多出一条滚动。 -->
    <div class="mx-auto flex min-h-[calc(100vh_-_var(--topbar-h))] max-w-4xl flex-col px-6 py-8 md:py-12">
      <div class="flex flex-1 flex-col gap-8 md:flex-row md:gap-12">
        <main class="min-w-0 flex-1">
          <slot />
        </main>
        <Rail lang={lang} related={related} headings={headings} />
      </div>
      <SiteFooter lang={lang} />
    </div>
    <BackToTop lang={lang} />

    <!-- 公众号二维码弹层：Banner / 右栏 / 页尾三处共用这一个面板。
         面板放在 body 层（根层叠上下文），不放进右栏的层叠上下文里：
         右栏是 position: sticky，会造层叠上下文，面板关在里面就压不过顶栏的 z-40；
         而把右栏本身抬到顶栏之上，页尾出现时右栏会被 sticky 顶出视口顶部，
         反而盖住顶栏自己的「中文 / English + 主题按钮」。
         pt-2 pb-2 是给触发器留的「桥」：朝上时底部 8px、朝下时顶部 8px
         仍然在面板的盒内，鼠标从触发器移进面板不会脱出。 -->
    <span
      id="wechat-qr"
      hidden
      class="fixed z-50 block w-max pt-2 pb-2"
      data-wechat-panel
    >
      <span class="block rounded border border-neutral-200 bg-white p-2 shadow-lg">
        <img
          src="/wechat-qr.jpg"
          alt={wechat.alt}
          width="430"
          height="430"
          class="h-32 w-32"
        />
        <span class="mt-1 block text-center text-xs text-neutral-500">
          {wechat.caption}
        </span>
      </span>
    </span>

    <!-- 面板脚本排在面板之后：脚本里直接查 #wechat-qr。 -->
    <script is:inline>
      (() => {
        const ROOT = "[data-wechat]";
        const TRIGGER = "[data-wechat-trigger]";
        const panel = document.querySelector("#wechat-qr");
        const roots = Array.from(document.querySelectorAll(ROOT));
        if (!panel || roots.length === 0) return;

        // 面板只有一个，同一时刻最多由一个触发器拥有。
        let activeTrigger = null;
        // 延迟收起的定时器：面板不在触发器子树里，鼠标移过去要留出时间。
        let hideTimer = null;

        // 判断焦点是不是键盘给的：鼠标/触摸按下后紧接着的 focusin 不算，
        // 否则「点击展开」会先被 focusin 打开、再被 click 关掉。
        let pointerFocus = false;
        document.addEventListener(
          "pointerdown",
          () => {
            pointerFocus = true;
          },
          true,
        );
        document.addEventListener(
          "keydown",
          () => {
            pointerFocus = false;
          },
          true,
        );

        // 面板是 position: fixed（右栏是滚动容器，absolute 会被裁剪盒切掉）。
        // 固定定位的基准是视口，位置只能按触发器当下的视口矩形现算。
        // 方向从触发器上读（data-wechat-dir），三个触发器现在都是 up：
        // 面板底边贴触发器顶边；横向左边贴触发器左边，右边与左右各留 8px。
        const placePanel = (panel, trigger) => {
          // 先清掉上一次算的位置，重新量。
          panel.style.top = "";
          panel.style.left = "";
          const t = trigger.getBoundingClientRect();
          const p = panel.getBoundingClientRect();
          const dir = trigger.dataset.wechatDir === "down" ? "down" : "up";
          const margin = 8;

          let top = dir === "up" ? t.top - p.height : t.bottom;
          // 上方空间不够时贴视口顶边，宁可少一点缝也不能让面板跑出视口。
          if (top < 0) top = 0;
          if (top + p.height > window.innerHeight - margin) {
            top = Math.max(0, window.innerHeight - margin - p.height);
          }

          let left = t.left;
          if (left + p.width > window.innerWidth - margin) {
            left = window.innerWidth - margin - p.width;
          }
          if (left < margin) left = margin;

          panel.style.top = `${top}px`;
          panel.style.left = `${left}px`;
        };

        const show = (trigger) => {
          clearTimeout(hideTimer);
          if (activeTrigger && activeTrigger !== trigger) {
            activeTrigger.setAttribute("aria-expanded", "false");
          }
          activeTrigger = trigger;
          trigger.setAttribute("aria-expanded", "true");
          // 顺序不能反：先去掉 hidden 才有真实宽高可量，量完再定位。
          panel.hidden = false;
          placePanel(panel, trigger);
        };

        const hide = () => {
          clearTimeout(hideTimer);
          if (activeTrigger) {
            activeTrigger.setAttribute("aria-expanded", "false");
            activeTrigger = null;
          }
          panel.hidden = true;
        };

        // 一次只开一个：除 except 这一个 root 外，其余全部标记收起。
        const closeAll = (except) => {
          roots.forEach((root) => {
            if (root === except) return;
            const trigger = root.querySelector(TRIGGER);
            if (trigger) trigger.setAttribute("aria-expanded", "false");
          });
          if (activeTrigger && !(except && except.contains(activeTrigger))) {
            panel.hidden = true;
            activeTrigger = null;
          }
        };

        // 触屏没有悬停，靠 matchMedia 兜住，「触屏只有点击」。
        const canHover = () => window.matchMedia("(hover: hover)").matches;

        // 共享面板不在触发器的 DOM 子树里，鼠标从触发器移向面板会先触发 mouseleave。
        // 所以关改成「延迟关」：150ms 后鼠标既不在任何触发器上、也不在面板上，才真的收起。
        const anyHovered = () =>
          Array.from(document.querySelectorAll(TRIGGER)).some((trigger) =>
            trigger.matches(":hover"),
          ) || panel.matches(":hover");

        const scheduleHide = () => {
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => {
            if (!anyHovered()) hide();
          }, 150);
        };

        roots.forEach((root) => {
          const trigger = root.querySelector(TRIGGER);
          if (!trigger) return;

          root.addEventListener("mouseenter", () => {
            if (!canHover()) return;
            closeAll(root);
            show(trigger);
          });

          // 不是立即关：鼠标可能正从触发器往面板挪。
          root.addEventListener("mouseleave", () => {
            if (!canHover()) return;
            scheduleHide();
          });

          // 桌面鼠标只用悬停，点击不切换；只有没有悬停能力的设备才靠点击。
          if (!canHover()) {
            trigger.addEventListener("click", () => {
              const next = panel.hidden || activeTrigger !== trigger;
              if (next) {
                closeAll(root);
                show(trigger);
              } else {
                hide();
              }
            });
          }

          root.addEventListener("focusin", () => {
            if (pointerFocus) return;
            closeAll(root);
            show(trigger);
          });

          root.addEventListener("focusout", (event) => {
            if (root.contains(event.relatedTarget)) return;
            if (activeTrigger === trigger) hide();
          });
        });

        // 面板自己也要接住鼠标：进去就取消收起，出来再重新计时。
        panel.addEventListener("mouseenter", () => {
          clearTimeout(hideTimer);
        });

        panel.addEventListener("mouseleave", () => {
          if (!canHover()) return;
          scheduleHide();
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return hide();
          // 面板本身不算「外面」，点它不该收起。
          if (target.closest(ROOT) || panel.contains(target)) return;
          hide();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          hide();
        });

        // 面板吃的是视口坐标，触发器却会随页面滚动、右栏内部滚动、窗口缩放移动，
        // 所以已经打开的面板要跟着重算，而不是关掉。
        // scroll 不冒泡，用捕获接住右栏这种内部滚动容器的滚动。
        const reposition = () => {
          if (!activeTrigger || panel.hidden) return;
          placePanel(panel, activeTrigger);
        };
        window.addEventListener("scroll", reposition, {
          passive: true,
          capture: true,
        });
        window.addEventListener("resize", reposition);
      })();
    </script>
  </body>
</html>

<style is:global>
  /* 顶栏总高：26px 控件 + 上下各 10px（py-2.5）+ 1px 分隔线 = 47px。
     右栏的吸顶位置和内部滚动上限都读这个变量，改栏高只改这一处。 */
  :root {
    --topbar-h: 47px;
  }

  /* 冻结顶栏会盖住锚点目标，给标题留出「栏高 + 16px」的空隙。 */
  .prose :is(h2, h3) {
    scroll-margin-top: calc(var(--topbar-h) + 1rem);
  }
</style>
