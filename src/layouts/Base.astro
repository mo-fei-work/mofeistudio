---
import "../styles/global.css";
import "@fontsource/jetbrains-mono/400.css";
import SiteHead from "../components/SiteHead.astro";
import Rail from "../components/Rail.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  lang: "zh" | "en";
  title: string;
  description?: string;
  altHref: string;
  related?: { href: string; title: string }[];
}

const { lang, title, description, altHref, related = [] } = Astro.props;
const htmlLang = lang === "zh" ? "zh-CN" : "en";
---

<!doctype html>
<html lang={htmlLang}>
  <SiteHead title={title} description={description} lang={lang} />
  <body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-900 dark:text-neutral-200">
    <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6 py-8 md:py-12">
      <div class="flex flex-1 flex-col-reverse gap-8 md:flex-row md:gap-12">
        <main class="min-w-0 flex-1">
          <slot />
        </main>
        <Rail lang={lang} altHref={altHref} related={related} />
      </div>
      <SiteFooter lang={lang} />
    </div>
  </body>
</html>
