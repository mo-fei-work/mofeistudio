---
import "../styles/global.css";
import "@fontsource/jetbrains-mono/400.css";
import type { MarkdownHeading } from "astro";
import SiteHead from "../components/SiteHead.astro";
import TopNav from "../components/TopNav.astro";
import Rail from "../components/Rail.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  lang: "zh" | "en";
  title: string;
  description?: string;
  altHref: string;
  related?: { href: string; title: string }[];
  headings?: MarkdownHeading[];
  noIndex?: boolean;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  altHref,
  related = [],
  headings = [],
  noIndex,
  ogType,
  jsonLd,
} = Astro.props;
const htmlLang = lang === "zh" ? "zh-CN" : "en";
---

<!doctype html>
<html lang={htmlLang}>
  <SiteHead
    title={title}
    description={description}
    lang={lang}
    noIndex={noIndex}
    ogType={ogType}
    jsonLd={jsonLd}
  />
  <body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-900 dark:text-neutral-200">
    <!-- 冻结顶栏：外层通栏给底色和分隔线，内层再限 896px 版心。
         底色不能只给 896px 的容器，否则视口更宽时栏两侧会漏出滚动正文。 -->
    <div class="sticky top-0 z-40 border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
      <div class="mx-auto max-w-4xl px-6">
        <TopNav lang={lang} altHref={altHref} />
      </div>
    </div>

    <!-- 顶栏移出容器后，最小高度要扣掉栏高，否则短页也会多出一条滚动。 -->
    <div class="mx-auto flex min-h-[calc(100vh_-_var(--topbar-h))] max-w-4xl flex-col px-6 py-8 md:py-12">
      <div class="flex flex-1 flex-col gap-8 md:flex-row md:gap-12">
        <main class="min-w-0 flex-1">
          <slot />
        </main>
        <Rail lang={lang} related={related} headings={headings} />
      </div>
      <SiteFooter lang={lang} />
    </div>
    <BackToTop lang={lang} />

    <!-- 公众号二维码弹层：Banner / 右栏 / 页尾三处共用这一套，
         放在布局末尾，等所有子组件都渲染完再找 [data-wechat]。 -->
    <script is:inline>
      (() => {
        const ROOT = "[data-wechat]";
        const TRIGGER = "[data-wechat-trigger]";
        const PANEL = "[data-wechat-panel]";

        const roots = document.querySelectorAll(ROOT);
        if (roots.length === 0) return;

        // 判断焦点是不是键盘给的：鼠标/触摸按下后紧接着的 focusin 不算，
        // 否则「点击展开」会先被 focusin 打开、再被 click 关掉。
        let pointerFocus = false;
        document.addEventListener(
          "pointerdown",
          () => {
            pointerFocus = true;
          },
          true,
        );
        document.addEventListener(
          "keydown",
          () => {
            pointerFocus = false;
          },
          true,
        );

        // 三个面板都是 position: fixed（右栏是滚动容器，absolute 会被裁剪盒切掉）。
        // 固定定位的基准是视口，位置只能按触发器当下的视口矩形现算：
        // 纵向 up 时面板底边贴触发器顶边、down 时面板顶边贴触发器底边，
        // 横向左边贴触发器左边；下边与左右各留 8px，上边见下面的说明。
        const placePanel = (panel, trigger) => {
          // 先清掉上一次算的位置，重新量。
          panel.style.top = "";
          panel.style.left = "";
          const t = trigger.getBoundingClientRect();
          const p = panel.getBoundingClientRect();
          const dir = panel.dataset.wechatDir === "down" ? "down" : "up";
          const margin = 8;

          let top = dir === "up" ? t.top - p.height : t.bottom;
          // up 时上边不留 8px 余量，直接贴视口边：首页「关注我」距顶只有 175px，
          // 面板高 174px，硬留 8px 会把面板压到触发器上、切掉按钮文字。
          if (top < 0) top = 0;
          if (top + p.height > window.innerHeight - margin) {
            top = Math.max(0, window.innerHeight - margin - p.height);
          }

          let left = t.left;
          if (left + p.width > window.innerWidth - margin) {
            left = window.innerWidth - margin - p.width;
          }
          if (left < margin) left = margin;

          panel.style.top = `${top}px`;
          panel.style.left = `${left}px`;
        };

        const setOpen = (root, open) => {
          const trigger = root.querySelector(TRIGGER);
          const panel = root.querySelector(PANEL);
          if (!trigger || !panel) return;

          panel.hidden = !open;
          trigger.setAttribute("aria-expanded", String(open));
          // 顺序不能反：先去掉 hidden 才有真实宽高可量，量完再定位。
          if (open) placePanel(panel, trigger);
        };

        const closeAll = (except) => {
          document.querySelectorAll(ROOT).forEach((root) => {
            if (root !== except) setOpen(root, false);
          });
        };

        // 触屏没有悬停，靠 matchMedia 兜住，「触屏只有点击」。
        const canHover = () => window.matchMedia("(hover: hover)").matches;

        roots.forEach((root) => {
          const trigger = root.querySelector(TRIGGER);
          if (!trigger) return;

          root.addEventListener("mouseenter", () => {
            if (!canHover()) return;
            closeAll(root);
            setOpen(root, true);
          });

          root.addEventListener("mouseleave", () => {
            if (!canHover()) return;
            setOpen(root, false);
          });

          // 桌面鼠标只用悬停，点击不切换；只有没有悬停能力的设备才靠点击。
          if (!canHover()) {
            trigger.addEventListener("click", () => {
              const panel = root.querySelector(PANEL);
              const next = Boolean(panel && panel.hidden);
              closeAll(root);
              setOpen(root, next);
            });
          }

          root.addEventListener("focusin", () => {
            if (pointerFocus) return;
            closeAll(root);
            setOpen(root, true);
          });

          root.addEventListener("focusout", (event) => {
            if (root.contains(event.relatedTarget)) return;
            setOpen(root, false);
          });
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest(ROOT)) return;
          closeAll(null);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          closeAll(null);
        });

        // 面板吃的是视口坐标，触发器却会随页面滚动、右栏内部滚动、窗口缩放移动，
        // 所以已经打开的面板要跟着重算，而不是关掉。
        // scroll 不冒泡，用捕获接住右栏这种内部滚动容器的滚动。
        const reposition = () => {
          document.querySelectorAll(ROOT).forEach((root) => {
            const panel = root.querySelector(PANEL);
            if (!panel || panel.hidden) return;
            const trigger = root.querySelector(TRIGGER);
            if (trigger) placePanel(panel, trigger);
          });
        };
        window.addEventListener("scroll", reposition, {
          passive: true,
          capture: true,
        });
        window.addEventListener("resize", reposition);
      })();
    </script>
  </body>
</html>

<style is:global>
  /* 顶栏总高：26px 控件 + 上下各 10px（py-2.5）+ 1px 分隔线 = 47px。
     右栏的吸顶位置和内部滚动上限都读这个变量，改栏高只改这一处。 */
  :root {
    --topbar-h: 47px;
  }

  /* 冻结顶栏会盖住锚点目标，给标题留出「栏高 + 16px」的空隙。 */
  .prose :is(h2, h3) {
    scroll-margin-top: calc(var(--topbar-h) + 1rem);
  }
</style>
